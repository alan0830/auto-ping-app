<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ Auto Ping"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Status Indicator Pill -->
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stat_box"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="● RUNNING"
            android:textColor="@color/terminal_text_green"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Settings Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <!-- Input Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Target IP / Host -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTargetIp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2.2"
                android:hint="目標 IP 或網址"
                app:boxStrokeColor="@color/primary_accent"
                app:hintTextColor="@color/primary_accent"
                app:boxBackgroundColor="@color/surface_card"
                android:textColorHint="@color/terminal_text_muted"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTargetIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:text="8.8.8.8"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="8dp"
                android:layout_height="match_parent" />

            <!-- Interval -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilInterval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="間隔(秒)"
                app:boxStrokeColor="@color/primary_accent"
                app:hintTextColor="@color/primary_accent"
                app:boxBackgroundColor="@color/surface_card"
                android:textColorHint="@color/terminal_text_muted"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="1.0"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Options & Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <CheckBox
                android:id="@+id/cbKeepScreenOn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:buttonTint="@color/primary_accent"
                android:text="@string/keep_screen_on"
                android:textColor="@color/terminal_text_muted"
                android:textSize="12sp" />

            <!-- Stop/Start Toggle Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTogglePing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_stop"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                android:backgroundTint="@color/btn_stop" />

            <View
                android:layout_width="6dp"
                android:layout_height="match_parent" />

            <!-- Restart Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="重啟"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                android:backgroundTint="@color/surface_card"
                android:textColor="@color/white"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>
    </LinearLayout>

    <!-- Real-time Stats Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <!-- Stat: Sent -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_stat_box"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stat_sent"
                android:textColor="@color/terminal_text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvStatSent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Stat: Received -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_stat_box"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginHorizontal="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stat_recv"
                android:textColor="@color/terminal_text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvStatRecv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/terminal_text_green"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Stat: Loss % -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_stat_box"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginHorizontal="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stat_loss"
                android:textColor="@color/terminal_text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvStatLoss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Stat: Avg Ping -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:background="@drawable/bg_stat_box"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginStart="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stat_avg"
                android:textColor="@color/terminal_text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvStatAvg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="- ms"
                android:textColor="@color/primary_accent"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Terminal Header & Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="即時終端輸出"
            android:textColor="@color/terminal_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCopyLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="複製"
            android:textColor="@color/primary_accent"
            android:textSize="12sp"
            android:padding="6dp" />

        <TextView
            android:id="@+id/btnClearLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清除"
            android:textColor="@color/terminal_text_muted"
            android:textSize="12sp"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Terminal Output Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_terminal"
        android:padding="10dp">

        <ScrollView
            android:id="@+id/svLogScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvTerminalOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="正在啟動持續 ping...\n"
                android:textColor="@color/terminal_text_green"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:textIsSelectable="true" />
        </ScrollView>
    </FrameLayout>

</LinearLayout>
